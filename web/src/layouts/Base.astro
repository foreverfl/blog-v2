---
import "../../styles/globals.css";
import { ClientRouter } from "astro:transitions";
import NavbarIsland from "@/components/islands/NavbarIsland";
import FooterIsland from "@/components/islands/FooterIsland";

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  image?: string;
}

const {
  title = "mogumogu's blog",
  description = "",
  lang = "en",
  image = "",
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="article" />
    {image && <meta property="og:image" content={image} />}
    <!-- Twitter -->
    <meta
      name="twitter:card"
      content={image ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {image && <meta name="twitter:image" content={image} />}

    <!-- Same rule as next-themes in Providers.tsx, applied before the first paint -->
    <script is:inline>
      {
        const applyTheme = () => {
          let storedTheme = null;
          try {
            storedTheme = localStorage.getItem("theme");
          } catch {}
          const prefersDark = matchMedia("(prefers-color-scheme: dark)").matches;
          const isDark =
            storedTheme === "dark" ||
            ((!storedTheme || storedTheme === "system") && prefersDark);
          document.documentElement.classList.toggle("dark", isDark);
          document.documentElement.style.colorScheme = isDark ? "dark" : "light";
        };
        applyTheme();
        // ClientRouter replaces <html> attributes with the new page's, which drops the class
        document.addEventListener("astro:after-swap", applyTheme);
      }
    </script>
    <ClientRouter />
  </head>
  <body>
    <NavbarIsland client:only="react" transition:persist="navbar" />
    <div class="min-h-screen">
      <slot />
    </div>
    <FooterIsland client:only="react" transition:persist="footer" />
    <script>
      import "@/lib/faro";
    </script>
    <script>
      // react-modal mounts its portal on <body>, which ClientRouter replaces on every navigation
      document.addEventListener("astro:before-swap", (event) => {
        event.newDocument.body.append(
          ...document.querySelectorAll("body > .ReactModalPortal"),
        );
        // Query devtools keep their CSS in <style id="_goober">, which the <head> swap drops
        event.newDocument.head.append(...document.querySelectorAll("#_goober"));
      });
    </script>
  </body>
</html>
