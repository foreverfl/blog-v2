{
  "categories": [
    { "title": "## 🚀 Features",      "rules": [{ "pattern": "^feat(\\(.*\\))?:",       "on_property": "title", "flags": "iu" }] },
    { "title": "## 🐛 Bug Fixes",     "rules": [{ "pattern": "^(bug|fix)(\\(.*\\))?:",  "on_property": "title", "flags": "iu" }] },
    { "title": "## 📝 Documentation", "rules": [{ "pattern": "^(docs|dcos)(\\(.*\\))?:", "on_property": "title", "flags": "iu" }] },
    { "title": "## ♻️ Refactoring",   "rules": [{ "pattern": "^refactor(\\(.*\\))?:",   "on_property": "title", "flags": "iu" }] },
    { "title": "## ⚡ Performance",    "rules": [{ "pattern": "^perf(\\(.*\\))?:",       "on_property": "title", "flags": "iu" }] },
    { "title": "## 🔧 Maintenance",   "rules": [{ "pattern": "^chore(\\(.*\\))?:",      "on_property": "title", "flags": "iu" }] },
    { "title": "## 🧪 Tests",         "rules": [{ "pattern": "^test(\\(.*\\))?:",       "on_property": "title", "flags": "iu" }] },
    { "title": "## 🔬 Spikes",        "rules": [{ "pattern": "^spike(\\(.*\\))?:",      "on_property": "title", "flags": "iu" }] }
  ],
  "template": "#{{CHANGELOG}}\n#{{UNCATEGORIZED}}\n\n**Full Changelog**: #{{RELEASE_DIFF}}",
  "commit_template": "- #{{TITLE}} (#{{MERGE_SHA}})",
  "empty_template": "- No changes",
  "uncategorized_title": "## 🗂 Other"
}
